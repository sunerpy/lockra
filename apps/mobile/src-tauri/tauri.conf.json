{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lockra",
  "version": "../../../package.json",
  "identifier": "dev.lockra.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Lockra", "width": 390, "height": 844, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "An offline two-factor authenticator",
    "android": { "minSdkVersion": 26 }
  }
}
