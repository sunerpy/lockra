<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing of Lockra's goes to a cloud backup or to a new phone by the
     system's transfer (allowBackup="false" covers the versions before). The vault moves with
     Lockra's own encrypted backups; the Keystore key never leaves this phone anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
